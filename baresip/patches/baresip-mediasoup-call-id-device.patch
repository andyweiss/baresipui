+static int account_audio_device(char **devicep, const char *module,
+				const char *device, const char *callid)
+{
+	static const char hex[] = "0123456789abcdef";
+	uint8_t digest[SHA256_DIGEST_SIZE];
+	char identity[SHA256_DIGEST_SIZE * 2 + 1];
+	size_t i;
+
+	if (!devicep || !str_isset(module) || !str_isset(device))
+		return EINVAL;
+
+	if (str_cmp(module, "mediasoup"))
+		return str_dup(devicep, device);
+
+	if (!str_isset(callid) || strchr(device, '|'))
+		return EINVAL;
+
+	sha256((const uint8_t *)callid, str_len(callid), digest);
+	for (i = 0; i < RE_ARRAY_SIZE(digest); ++i) {
+		identity[2 * i] = hex[digest[i] >> 4];
+		identity[2 * i + 1] = hex[digest[i] & 0x0f];
+	}
+	identity[sizeof(identity) - 1] = '\0';
+
+	return re_sdprintf(devicep, "%s|%s", device, identity);
+}
