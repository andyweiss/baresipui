# ALSA configuration for Digigram RAVENNA / ALPAES67 (64 channels)
# Exposes:
#  - pcm.ravenna_shared_out : shared playback (dmix)
#  - pcm.ravenna_shared_in  : shared capture  (dsnoop)
#  - pcm.in_ch1..64         : mono capture devices
#  - pcm.out_ch1..64        : mono playback devices

pcm.ravenna_shared_out {
    type dmix
    ipc_key 0x999999
    slave {
        pcm "hw:CARD=ALPAES6764,DEV=0"
        channels 64
        rate 48000
        format S32_LE
        period_time 128
        buffer_time 512
        periods 4
    }
}

pcm.ravenna_shared_in {
    type dsnoop
    ipc_key 0x888888
    slave {
        pcm "hw:CARD=ALPAES6764,DEV=0"
        channels 64
        rate 48000
        format S32_LE
        period_time 128
        buffer_time 512
        periods 4
    }
}

pcm_slave.ravenna_in_64 {
    pcm "ravenna_shared_in"
    channels 64
    format S32_LE
}

pcm_slave.ravenna_out_64 {
    pcm "ravenna_shared_out"
    channels 64
    format S32_LE
}

pcm.in_ch1 {
    type route
    slave ravenna_in_64
    ttable {
        0.0  1.0
    }
}

pcm.out_ch1 {
    type plug
